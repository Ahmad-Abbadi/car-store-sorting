.review-root { flex-grow: 1; -unity-font: url("project://database/Assets/TextMesh Pro/Fonts/LiberationSans.ttf"); font-size: 14px; color: #ecf2fa; }
.review-panel { width: 250px; max-height: 96%; padding: 12px; margin: 12px; background-color: #172538; border-radius: 8px; }
.review-title { font-size: 19px; -unity-font-style: bold; margin-bottom: 6px; }
.review-caption { white-space: normal; margin-bottom: 8px; color: #bacde3; }
.review-panel Button { min-height: 28px; margin: 2px; padding: 4px 7px; color: #ecf2fa; background-color: #304863; border-width: 1px; border-color: #536d8c; border-radius: 4px; -unity-text-align: middle-center; }
.review-panel Button:hover { background-color: #47698c; }
.review-panel .selected { background-color: #276e91; border-color: #64c5ee; }
.review-row { flex-direction: row; }
.review-row Button { flex-grow: 1; }
.review-themes { height: 150px; flex-shrink: 1; margin-top: 5px; margin-bottom: 7px; }
.review-cars { flex-direction: row; flex-wrap: wrap; }
.review-cars Button { width: 68px; }
.review-panel TextField { margin: 2px; }
.review-panel .unity-base-text-field__input { min-height: 27px; padding: 5px; background-color: #edf4fc; color: #142337; }
.review-themes .unity-scroll-view__content-and-vertical-scroll-container { flex-direction: row; flex-grow: 1; overflow: hidden; }
.review-themes .unity-scroll-view__content-viewport { flex-grow: 1; overflow: hidden; }
.review-themes .unity-scroll-view__content-container { flex-shrink: 0; }
.review-themes .unity-scroll-view__vertical-scroller { width: 12px; }
.review-themes .unity-scroller__low-button, .review-themes .unity-scroller__high-button { display: none; }
.review-themes .unity-scroller__slider, .review-themes .unity-base-slider__input, .review-themes .unity-base-slider__drag-container { flex-grow: 1; }
.review-themes .unity-base-slider__drag-container { position: relative; background-color: #243a52; }
.review-themes .unity-base-slider__dragger { position: absolute; width: 10px; min-height: 20px; background-color: #86abc9; border-radius: 4px; }
.editor-review .review-panel { width: auto; max-height: none; flex-grow: 1; margin: 0; }
.editor-review .review-themes { flex-grow: 1; }
