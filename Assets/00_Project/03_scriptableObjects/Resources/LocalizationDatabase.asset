      \u0644\u0644\u063A\u0631\u0636 \u0627\u0644\u0630\u064A \u0641\u064A \u064A\u062F\u0643."
    - "\u062C\u0645\u0639 \u0627\u0644\u0623\u063A\u0631\u0627\u0636 \u062A\u0644\u0642\u0627\u0626\u064A\u064B\u0627"
    - "\u062A\u0637\u0641\u0648 \u0627\u0644\u0623\u063A\u0631\u0627\u0636 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629
      \u0648\u062A\u062A\u0648\u0647\u062C \u0644\u0645\u062F\u0629 {value} \u062B\u0627\u0646\u064A\u0629."
    - "\u062A\u0645\u064A\u064A\u0632 \u0627\u0644\u0623\u063A\u0631\u0627\u0636"
