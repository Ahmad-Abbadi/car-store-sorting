      \u0627\u0644\u0643\u0648\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636
      \u0648\u0636\u0639 \u0643\u0644 \u0633\u064A\u0627\u0631\u0629 \u0639\u0644\u0649
      \u0631\u0641 \u0637\u0631\u0627\u0632\u0647\u0627 \u0648\u0644\u0648\u0646\u0647\u0627.
      \u064A\u062D\u062A\u0627\u062C \u0643\u0644 \u0631\u0641 \u0625\u0644\u0649
      \u0633\u0628\u0639 \u0633\u064A\u0627\u0631\u0627\u062A. \u064A\u0645\u0643\u0646\u0643
      \u0627\u0633\u062A\u0631\u062C\u0627\u0639 \u0627\u0644\u0633\u064A\u0627\u0631\u0629
      \u0627\u0644\u0645\u0648\u0636\u0648\u0639\u0629 \u062E\u0637\u0623\u064B.
      \u0627\u0643\u0633\u0628 \u0639\u0645\u0644\u0627\u062A \u0644\u0644\u062A\u0631\u0642\u064A\u0627\u062A
      \u0639\u0646\u062F \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0635\u062D\u064A\u062D.
      \u0644\u0627 \u064A\u0648\u062C\u062F \u0645\u0624\u0642\u062A."
    - "W \u063A\u0631\u0628  \u2022  E \u0634\u0631\u0642  \u2022  B \u062E\u0644\u0641 
      \u2022  F \u0623\u0645\u0627\u0645"
