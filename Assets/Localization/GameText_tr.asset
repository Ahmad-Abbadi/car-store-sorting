    m_Metadata:
      m_Items: []
  - m_Id: 7309447262
    m_Localized: "KARI\u015EIK ARABALAR  \u2022  BURADAN AL"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447263
    m_Localized: "MODEL REHBER\u0130"
    m_Metadata:
      m_Items: []
