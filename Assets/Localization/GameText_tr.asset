    m_Localized: "MODEL {0}  \u2022  {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447265
    m_Localized: "S\u0131ralanan arabalar: {0} / 525"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447266
    m_Localized: "Ma\u011Fazay\u0131 yeniden oyna"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447267
    m_Localized: '{0}: {1} / 35'
    m_Metadata:
      m_Items: []
  - m_Id: 7309447268
    m_Localized: "Ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447269
    m_Localized: "OYUNCAK ARABA MA\u011EAZASI"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447270
    m_Localized: "Oyuncak araba ma\u011Fazas\u0131na ho\u015F geldin! Arabalar\u0131
      yerdeki y\u0131\u011F\u0131ndan al ve model ile rengine uygun rafa yerle\u015Ftir.
      Her raf yedi araba ister. Yanl\u0131\u015F arabalar\u0131 geri alabilirsin.
      Do\u011Fru yerle\u015Ftirerek geli\u015Ftirme paras\u0131 kazan. S\xFCre s\u0131n\u0131r\u0131
      yok."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447271
    m_Localized: "W BATI  \u2022  E DO\u011EU  \u2022  B ARKA  \u2022  F \xD6N"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447272
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 7309447273
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447274
    m_Localized: "\xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447275
    m_Localized: "T\xFCm ilerleme s\u0131f\u0131rlans\u0131n m\u0131?\nBu i\u015Flem
      geri al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447276
    m_Localized: "\u0130lerlemeyi S\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447277
    m_Localized: "Yeniden Ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447278
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 7309447279
    m_Localized: "Elindekiyle ayn\u0131 olan en fazla {value} e\u015Fyay\u0131 otomatik
      ku\u015Fan\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447280
    m_Localized: "E\u015Fyalar\u0131 otomatik topla"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447281
    m_Localized: "E\u015Fle\u015Fen e\u015Fyalar {value} saniye boyunca s\xFCz\xFCl\xFCr
      ve parlar."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447282
    m_Localized: "E\u015Fyalar\u0131 vurgula"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447283
    m_Localized: "At\u0131lan e\u015Fyalar otomatik olarak do\u011Fru rafa yerle\u015Fir."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447284
    m_Localized: "Do\u011Fru rafa at\u0131lan e\u015Fya otomatik yerle\u015Fir"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447285
    m_Localized: "Ayn\u0131 anda en fazla {value} e\u015Fya ta\u015F\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447286
    m_Localized: "Daha b\xFCy\xFCk envanter"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447287
    m_Localized: "Daha uzaktan al ve yerle\u015Ftir. Menzil: {value}."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447288
    m_Localized: Daha uzun menzil
    m_Metadata:
      m_Items: []
  - m_Id: 7309447289
    m_Localized: "E\u015Fyalar\u0131 daha sert ve uza\u011Fa at. G\xFC\xE7: {value}."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447290
    m_Localized: "Daha g\xFC\xE7l\xFC at\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447291
    m_Localized: "B\xF6l\xFCmde daha h\u0131zl\u0131 ko\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447292
    m_Localized: "Ko\u015Fuyu a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447293
    m_Localized: MAKS
    m_Metadata:
      m_Items: []
  - m_Id: 7309447294
    m_Localized: "Geli\u015Ftirmeler"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447295
