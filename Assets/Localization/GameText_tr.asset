      m_Items: []
  - m_Id: 7309447347
    m_Localized: "Yerle\u015Ftirildi \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447348
    m_Localized: "Koleksiyon tamamland\u0131 \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447349
    m_Localized: "Koleksiyon par\xE7as\u0131 kullan\u0131lam\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447350
    m_Localized: "Bu aksesuar i\xE7in daha fazla sergileme alan\u0131 gerekli"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447351
    m_Localized: "ARABA KOLEKS\u0130YONU"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447352
    m_Localized: "{0} tema \xB7 {1} tasar\u0131m \xB7 T\xFCm arabalar g\xF6r\xFCn\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447353
    m_Localized: Tema ara
    m_Metadata:
      m_Items: []
  - m_Id: 7309447354
    m_Localized: "\xD6nceki"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447355
    m_Localized: Sonraki
    m_Metadata:
      m_Items: []
  - m_Id: 7309447356
    m_Localized: Temaya odaklan
    m_Metadata:
      m_Items: []
  - m_Id: 7309447357
    m_Localized: "Genel g\xF6r\xFCn\xFCm \xB7 {0} araba"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447358
    m_Localized: "E\u015Fle\u015Fen tema yok"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447359
    m_Localized: "PageUp / PageDown: tema\nHome: genel g\xF6r\xFCn\xFCm\nRMB + WASD
      / QE: u\xE7u\u015F\nShift: h\u0131zlan \xB7 Tekerlek: yak\u0131nla\u015Ft\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447360
    m_Localized: AYARLAMA
    m_Metadata:
      m_Items: []
  - m_Id: 7309447361
    m_Localized: "GEL\u0130\u015ET\u0130RME LABORATUVARI"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447362
    m_Localized: "D\xF6nd\xFCr\n<size=18>Bas\u0131l\u0131 tut ve s\xFCr\xFCkle</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447363
    m_Localized: Toy Car Sort
    m_Metadata:
      m_Items: []
  - m_Id: 7309447364
    m_Localized: "KOLEKS\u0130YONCU REHBER\u0130\n01 Vah\u015Fi harikalar \xB7 02
      Sahil ve iklim\n03 Kozmik at\xF6lye \xB7 04 Efsaneler ve b\xFCy\xFC\n05 Hareketli
      \u015Fehir \xB7 06 Yarat\u0131c\u0131 k\xF6\u015Fe\n07 Parti ve ikramlar \xB7
      08 B\xFCy\xFCk maceralar"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447365
    m_Localized: "Hata ay\u0131klama: s\u0131f\u0131rlanamad\u0131; y\u0131\u011F\u0131n
      veya araba eksik"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447366
    m_Localized: "Hata ay\u0131klama: koleksiyon s\u0131f\u0131rland\u0131; arabalar
      y\u0131\u011F\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447367
    m_Localized: "Hata ay\u0131klama: yerle\u015Ftirilemedi; uygun raf alan\u0131
      yetersiz"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447368
    m_Localized: "Hata ay\u0131klama: t\xFCm arabalar yerle\u015Ftirildi"
    m_Metadata:
      m_Items: []
