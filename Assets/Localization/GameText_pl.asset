    m_Localized: "Rzucone przedmioty same trafiaj\u0105 na w\u0142a\u015Bciw\u0105
      p\xF3\u0142k\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447284
    m_Localized: "Auto-odk\u0142adanie po rzucie na dobr\u0105 p\xF3\u0142k\u0119"
    m_Metadata:
      m_Items: []
