    m_Localized: Restart
    m_Metadata:
      m_Items: []
  - m_Id: 7309447278
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 7309447279
    m_Localized: "Automatycznie bierze do {value} przedmiot\xF3w takich jak ten w
      r\u0119ce."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447280
    m_Localized: "Automatyczne zbieranie przedmiot\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447281
    m_Localized: "Pasuj\u0105ce przedmioty unosz\u0105 si\u0119 i \u015Bwiec\u0105
      przez {value} s."
    m_Metadata:
      m_Items: []
