      m_Items: []
  - m_Id: 15447427469331
    m_Localized: "Odbierz nagrody przy tablicy zada\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469332
    m_Localized: "Wszystkie wyzwania tego sklepu uko\u0144czone"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469333
    m_Localized: "Tutaj pojawi\u0105 si\u0119 odebrane zadania"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469334
