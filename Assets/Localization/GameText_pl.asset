    m_Metadata:
      m_Items: []
  - m_Id: 15447427469312
    m_Localized: Zadania kolekcjonera
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469313
    m_Localized: "SORTUJ \u2022 ODKRYWAJ \u2022 ROZWIJAJ SI\u0118"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469314
    m_Localized: "Tw\xF3j kolejny cel zaczyna si\u0119 tutaj"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469315
    m_Localized: 'Gotowe nagrody: {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469316
    m_Localized: ZADANIA KOLEKCJONERA
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469317
    m_Localized: "Ma\u0142e cele. Wspania\u0142a kolekcja."
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469318
    m_Localized: "Bez po\u015Bpiechu i limit\xF3w czasu. Stw\xF3rz w\u0142asny salon."
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469319
    m_Localized: "Podr\xF3\u017C"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469320
    m_Localized: Wyzwania
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469321
    m_Localized: "Uko\u0144czone"
