  - m_Id: 7309447269
    m_Localized: SKLEP Z AUTKAMI
    m_Metadata:
      m_Items: []
  - m_Id: 7309447270
    m_Localized: "Witamy w sklepie z autkami! Bierz auta ze sterty na pod\u0142odze
      i dopasuj model oraz kolor do p\xF3\u0142ki. Ka\u017Cda p\xF3\u0142ka potrzebuje
      siedmiu sztuk. B\u0142\u0119dne auta mo\u017Cna zabra\u0107. Za poprawne odk\u0142adanie
      dostajesz monety na ulepszenia. Nie ma limitu czasu."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447271
    m_Localized: "W ZACH\xD3D  \u2022  E WSCH\xD3D  \u2022  B TY\u0141  \u2022  F
      PRZ\xD3D"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447272
    m_Localized: Kontynuuj
    m_Metadata:
      m_Items: []
  - m_Id: 7309447273
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 7309447274
    m_Localized: "Wyjd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447275
    m_Localized: "Zresetowa\u0107 ca\u0142y post\u0119p?\nTego nie da si\u0119 cofn\u0105\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447276
    m_Localized: "Resetuj post\u0119p"
    m_Metadata:
      m_Items: []
