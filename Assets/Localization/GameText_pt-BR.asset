      m_Items: []
  - m_Id: 15447427469312
    m_Localized: "Miss\xF5es de cole\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469313
    m_Localized: "ORGANIZE \u2022 DESCUBRA \u2022 CRES\xC7A"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469314
    m_Localized: "Seu pr\xF3ximo objetivo come\xE7a aqui"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469315
    m_Localized: '{0} recompensas prontas!'
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469316
    m_Localized: "MISS\xD5ES DE COLE\xC7\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469317
    m_Localized: "Pequenos objetivos. Uma cole\xE7\xE3o espetacular."
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469318
    m_Localized: "Sem pressa ou cron\xF4metros. O showroom \xE9 seu."
    m_Metadata:
      m_Items: []
