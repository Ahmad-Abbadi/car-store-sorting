  - m_Id: 7309447269
    m_Localized: LOJA DE CARRINHOS
    m_Metadata:
      m_Items: []
  - m_Id: 7309447270
    m_Localized: "Bem-vindo \xE0 loja de carrinhos! Pegue carros da pilha no ch\xE3o
      e coloque-os na prateleira do modelo e cor certos. Cada prateleira precisa
      de sete. Retire os incorretos. Ganhe moedas para melhorias. N\xE3o h\xE1 tempo
      limite."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447271
    m_Localized: "W OESTE  \u2022  E LESTE  \u2022  B FUNDO  \u2022  F FRENTE"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447272
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 7309447273
    m_Localized: "N\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447274
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 7309447275
    m_Localized: "Zerar todo o progresso?\nIsso n\xE3o pode ser desfeito."
    m_Metadata:
      m_Items: []
