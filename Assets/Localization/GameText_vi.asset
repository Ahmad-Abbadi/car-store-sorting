    m_Localized: "C\u1EECA H\xC0NG XE \u0110\u1ED2 CH\u01A0I"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447270
    m_Localized: "Ch\xE0o m\u1EEBng \u0111\u1EBFn c\u1EEDa h\xE0ng xe \u0111\u1ED3
      ch\u01A1i! L\u1EA5y xe t\u1EEB \u0111\u1ED1ng tr\xEAn s\xE0n v\xE0 \u0111\u1EB7t
      l\xEAn k\u1EC7 \u0111\xFAng m\u1EABu, \u0111\xFAng m\xE0u. M\u1ED7i k\u1EC7
      c\u1EA7n b\u1EA3y xe. C\xF3 th\u1EC3 l\u1EA5y l\u1EA1i xe \u0111\u1EB7t sai.
      \u0110\u1EB7t \u0111\xFAng \u0111\u1EC3 nh\u1EADn xu n\xE2ng c\u1EA5p. Kh\xF4ng
      gi\u1EDBi h\u1EA1n th\u1EDDi gian."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447271
    m_Localized: "W T\xC2Y  \u2022  E \u0110\xD4NG  \u2022  B SAU  \u2022  F TR\u01AF\u1EDAC"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447272
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447273
    m_Localized: "Kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447274
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447275
    m_Localized: "X\xF3a to\xE0n b\u1ED9 ti\u1EBFn tr\xECnh?\nKh\xF4ng th\u1EC3 ho\xE0n
      t\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447276
    m_Localized: "X\xF3a ti\u1EBFn tr\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447277
    m_Localized: "Ch\u01A1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447278
    m_Localized: "C\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447279
    m_Localized: "T\u1EF1 \u0111\u1ED9ng c\u1EA7m t\u1ED1i \u0111a {value} m\xF3n
      gi\u1ED1ng m\xF3n tr\xEAn tay."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447280
    m_Localized: "T\u1EF1 \u0111\u1ED9ng nh\u1EB7t \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447281
    m_Localized: "\u0110\u1ED3 v\u1EADt gi\u1ED1ng nhau bay l\xEAn v\xE0 ph\xE1t
      s\xE1ng trong {value} gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447282
    m_Localized: "L\xE0m n\u1ED5i b\u1EADt \u0111\u1ED3 v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447283
    m_Localized: "\u0110\u1ED3 n\xE9m ra s\u1EBD t\u1EF1 v\xE0o \u0111\xFAng k\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447284
    m_Localized: "T\u1EF1 l\xEAn k\u1EC7 khi n\xE9m \u0111\xFAng k\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447285
    m_Localized: "Mang t\u1ED1i \u0111a {value} m\xF3n c\xF9ng l\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447286
    m_Localized: "T\xFAi \u0111\u1ED3 l\u1EDBn h\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447287
    m_Localized: "Nh\u1EB7t v\xE0 \u0111\u1EB7t t\u1EEB xa h\u01A1n. T\u1EA7m v\u1EDBi:
      {value}."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447288
    m_Localized: "T\u1EA7m v\u1EDBi xa h\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447289
    m_Localized: "N\xE9m \u0111\u1ED3 m\u1EA1nh v\xE0 xa h\u01A1n. L\u1EF1c: {value}."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447290
    m_Localized: "N\xE9m m\u1EA1nh h\u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447291
    m_Localized: "Ch\u1EA1y nhanh h\u01A1n trong m\xE0n ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7309447292
    m_Localized: "M\u1EDF kh\xF3a ch\u1EA1y nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447293
    m_Localized: "T\u1ED0I \u0110A"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447294
    m_Localized: "N\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447295
    m_Localized: "\u1EA8n h\u01B0\u1EDBng d\u1EABn \u0111i\u1EC1u khi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447296
    m_Localized: "\u0110ang t\u1EA3i\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447297
    m_Localized: "\u0110\u1ED9i kho b\xE1u"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447298
    m_Localized: "V\u1EC7 binh ho\xE0ng gia"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447299
    m_Localized: "C\xE2u l\u1EA1c b\u1ED9 qu\u1EF9 \u0111\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447300
    m_Localized: "Kh\xE1ch v\u0169 tr\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447301
    m_Localized: "B\u1EDD bi\u1EC3n n\u1EAFng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447302
    m_Localized: "R\u1EEBng hoang d\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447303
    m_Localized: "\u0110\u1ED9i ma nh\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447304
    m_Localized: "V\xF2ng xo\xE1y k\u1EB9o"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447305
    m_Localized: "Tr\u1EA1m \u0103n v\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447306
    m_Localized: "D\xF2ng dung nham"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447307
    m_Localized: "\u0110\u1ED9i tu\u1EA7n tra tuy\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447308
    m_Localized: "B\u1EA1n b\xE8 san h\xF4"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447309
    m_Localized: "Th\u1EE3 x\xE2y nh\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447310
    m_Localized: "B\xE0n tay gi\xFAp \u0111\u1EE1"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447311
    m_Localized: "Ph\xE9p thu\u1EADt tr\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447312
    m_Localized: "B\u1EA1n m\u1EA1ch \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447313
    m_Localized: "Chuy\u1EBFn xe nh\u1ECBp \u0111i\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447314
    m_Localized: "C\xF9ng ch\u01A1i b\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447315
    m_Localized: "G\xF3c \u0111\u1ED3ng qu\xEA"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447316
    m_Localized: "C\xE2u l\u1EA1c b\u1ED9 ph\xE1o gi\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447317
    m_Localized: "Mi\u1EC1n T\xE2y hoang d\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447318
    m_Localized: "Th\xE1m t\u1EED"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447319
    m_Localized: Ninja
    m_Metadata:
      m_Items: []
  - m_Id: 7309447320
    m_Localized: "Huy\u1EC1n tho\u1EA1i Viking"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447321
    m_Localized: "Ai C\u1EADp c\u1ED5 \u0111\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447322
    m_Localized: "Th\u1EBF gi\u1EDBi h\u01A1i n\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447323
    m_Localized: "Th\u1EDDi ti\u1EC1n s\u1EED"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447324
    m_Localized: "Ong m\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447325
    m_Localized: "V\u01B0\u1EDDn b\u01B0\u1EDBm"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447326
    m_Localized: "R\u1EEBng n\u1EA5m"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447327
    m_Localized: "Gi\xF4ng b\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447328
    m_Localized: "L\u1EC5 h\u1ED9i m\xF9a \u0111\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447329
    m_Localized: "\u0110\u01B0\u1EDDng s\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447330
    m_Localized: "H\xE0ng kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447331
    m_Localized: "\u0110i\u1EC7n \u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447332
    m_Localized: "Nhi\u1EBFp \u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447333
    m_Localized: "X\u01B0\u1EDFng ngh\u1EC7 thu\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447334
    m_Localized: "B\u01B0u \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447335
    m_Localized: "Ti\u1EC7m c\u1EAFt t\xF3c"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447336
    m_Localized: "Ph\xF2ng th\xED nghi\u1EC7m"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447337
    m_Localized: "\u0110\xE3 x\u1EBFp {0} / {1} \xB7 M\u1EABu {2} / {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447338
    m_Localized: "HO\xC0N TH\xC0NH B\u1ED8 S\u01AFU T\u1EACP\n\u0110\xE3 x\u1EBFp
      {0} xe\n{1} m\u1EABu \u0111\u1ED9c \u0111\xE1o \xB7 {2} ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447339
    m_Localized: "Ch\u01A1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447340
    m_Localized: "B\u1ED8 S\u01AFU T\u1EACP CH\u1EE6 \u0110\u1EC0"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447341
    m_Localized: "\u0110ang c\u1EA7m: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447342
    m_Localized: "\u0110ang c\u1EA7m: {0}\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447343
    m_Localized: "E / chu\u1ED9t tr\xE1i: nh\u1EB7t \xB7 F / chu\u1ED9t ph\u1EA3i:
      \u0111\u1EB7t ho\u1EB7c th\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447344
    m_Localized: "Ch\u1EA1m \u0111\u1EC3 nh\u1EB7t \xB7 D\xF9ng n\xFAt \u0111\u1EB7t
      \u0111\u1EC3 \u0111\u1EB7t ho\u1EB7c th\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447345
    m_Localized: "Nh\u1EB7t xe r\u1ED3i t\xECm k\u1EC7 \u0111\xFAng ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447346
    m_Localized: "\u0110\xE3 kh\xE1m ph\xE1 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447347
    m_Localized: "\u0110\xE3 x\u1EBFp \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447348
    m_Localized: "Ho\xE0n th\xE0nh b\u1ED9 s\u01B0u t\u1EADp \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447349
    m_Localized: "V\u1EADt ph\u1EA9m kh\xF4ng kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447350
    m_Localized: "Ph\u1EE5 ki\u1EC7n n\xE0y c\u1EA7n th\xEAm ch\u1ED7 tr\u01B0ng
      b\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447351
    m_Localized: "B\u1ED8 S\u01AFU T\u1EACP XE"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447352
    m_Localized: "{0} ch\u1EE7 \u0111\u1EC1 \xB7 {1} m\u1EABu \xB7 Lu\xF4n hi\u1EC3n
      th\u1ECB m\u1ECDi xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447353
    m_Localized: "T\xECm ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447354
    m_Localized: "Tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447355
    m_Localized: "Ti\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447356
    m_Localized: "Xem ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447357
    m_Localized: "T\u1ED5ng quan \xB7 T\u1EA5t c\u1EA3 {0} xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447358
    m_Localized: "Kh\xF4ng t\xECm th\u1EA5y ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447359
    m_Localized: "PageUp / PageDown: ch\u1EE7 \u0111\u1EC1\nHome: t\u1ED5ng quan\nRMB
      + WASD / QE: bay\nShift: nhanh h\u01A1n \xB7 Con l\u0103n: thu ph\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447360
    m_Localized: "TINH CH\u1EC8NH"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447361
    m_Localized: "PH\xD2NG N\xC2NG C\u1EA4P"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447362
    m_Localized: "Xoay\n<size=18>Gi\u1EEF v\xE0 k\xE9o</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447363
    m_Localized: Toy Car Sort
    m_Metadata:
      m_Items: []
  - m_Id: 7309447364
    m_Localized: "DANH M\u1EE4C NH\xC0 S\u01AFU T\u1EACP\n01 K\u1EF3 quan hoang d\xE3
      \xB7 02 Bi\u1EC3n v\xE0 kh\xED h\u1EADu\n03 X\u01B0\u1EDFng v\u0169 tr\u1EE5
      \xB7 04 Truy\u1EC1n thuy\u1EBFt v\xE0 ph\xE9p thu\u1EADt\n05 Th\u1ECB tr\u1EA5n
      nh\u1ED9n nh\u1ECBp \xB7 06 G\xF3c s\xE1ng t\u1EA1o\n07 Ti\u1EC7c v\xE0 b\xE1nh
      k\u1EB9o \xB7 08 Phi\xEAu l\u01B0u k\u1EF3 th\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447365
    m_Localized: "G\u1EE1 l\u1ED7i: kh\xF4ng th\u1EC3 \u0111\u1EB7t l\u1EA1i; thi\u1EBFu
      \u0111\u1ED1ng xe ho\u1EB7c m\u1EABu xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447366
    m_Localized: "G\u1EE1 l\u1ED7i: \u0111\xE3 \u0111\u1EB7t l\u1EA1i b\u1ED9 s\u01B0u
      t\u1EADp; xe v\u1EC1 \u0111\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447367
    m_Localized: "G\u1EE1 l\u1ED7i: kh\xF4ng th\u1EC3 x\u1EBFp h\u1EBFt; thi\u1EBFu
      ch\u1ED7 tr\xEAn k\u1EC7 ph\xF9 h\u1EE3p"
    m_Metadata:
      m_Items: []
  - m_Id: 7309447368
    m_Localized: "G\u1EE1 l\u1ED7i: \u0111\xE3 x\u1EBFp t\u1EA5t c\u1EA3 xe"
    m_Metadata:
      m_Items: []
