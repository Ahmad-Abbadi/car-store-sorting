      m_Items: []
  - m_Id: 56456626655254
    m_Localized: "Tr\u01B0ng b\xE0y {0} xe"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655255
    m_Localized: "Kh\xE1m ph\xE1 {0} m\u1EABu xe"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655256
    m_Localized: "{0} k\u1EC7 \u0111\xE1ng t\u1EF1 h\xE0o"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655257
    m_Localized: "{0} th\u1EBF gi\u1EDBi ho\xE0n ch\u1EC9nh"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655258
    m_Localized: "M\u1EDF kh\xF3a {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655259
    m_Localized: "L\xE0m ch\u1EE7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655260
    m_Localized: "{0} c\u1EA5p n\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655261
    m_Localized: "X\u1EBFp \u0111\xFAng {0} xe ch\u1EE7 \u0111\u1EC1 {1} l\xEAn k\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655262
    m_Localized: "X\u1EBFp \u0111\xFAng {0} xe {1} thu\u1ED9c c\xE1c ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655263
    m_Localized: "X\u1EBFp \u0111\xFAng {0} xe l\xEAn k\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655264
    m_Localized: "Kh\xE1m ph\xE1 {0} m\u1EABu xe kh\xE1c nhau"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655265
    m_Localized: "L\u1EA5p \u0111\u1EA7y \u0111\xFAng {0} k\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655266
    m_Localized: "Ho\xE0n th\xE0nh {0} ch\u1EE7 \u0111\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655267
    m_Localized: "\u0110\u1EA1t c\u1EA5p {0} c\u1EE7a {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655268
    m_Localized: "\u0110\u1EA1t c\u1EA5p {0} c\u1EE7a {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 56456626655269
    m_Localized: "S\u1EDF h\u1EEFu t\u1ED5ng c\u1ED9ng {0} c\u1EA5p n\xE2ng c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 64825697587200
    m_Localized: "S\u1ED4 S\u01AFU T\u1EA6M C\u1EE6A T\xD4I"
    m_Metadata:
      m_Items: []
  - m_Id: 64825701781504
    m_Localized: "S\u1ED4 S\u01AFU T\u1EA6M"
    m_Metadata:
      m_Items: []
  - m_Id: 64825701781505
    m_Localized: "\u0110\xC3 NH\u1EACN"
    m_Metadata:
      m_Items: []
  - m_Id: 64825701781506
    m_Localized: '{0} xu'
    m_Metadata:
      m_Items: []
  - m_Id: 64825701781507
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng \u0111ang ch\u1EDD t\u1EA1i b\u1EA3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 64825701781508
    m_Localized: "Th\u1EBB s\u01B0u t\u1EA7m c\xF3 huy hi\u1EC7u m\u1EDBi!"
    m_Metadata:
      m_Items: []
  - m_Id: 64825701781509
    m_Localized: "{0} th\xE0nh t\xEDch m\u1EDBi!"
    m_Metadata:
      m_Items: []
  - m_Id: 101445050126336
    m_Localized: "K\u1EC7 \u0111\u1EA7u ti\xEAn c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 101445129818112
    m_Localized: "\u0110i \u0111\u1EBFn chi\u1EBFc xe"
    m_Metadata:
      m_Items: []
  - m_Id: 101445129818113
    m_Localized: "Nh\u1EB7t chi\u1EBFc xe"
    m_Metadata:
      m_Items: []
  - m_Id: 101445129818114
    m_Localized: "\u0110\u1EB7t xe v\xE0o \u0111\xFAng k\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 101445129818115
    m_Localized: "X\u1EBFp hai chi\u1EBFc n\xE0y nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 101445129818116
    m_Localized: "S\u1EB5n s\xE0ng cho c\u1EEDa h\xE0ng c\u1EE7a b\u1EA1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 101445129818117
    m_Localized: "L\u1EA5y l\u1EA1i xe v\xE0 gh\xE9p \u0111\xFAng h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 101445138206720
    m_Localized: "\u0110\xE3 x\u1EBFp {0} / 3"
    m_Metadata:
      m_Items: []
  - m_Id: 101445138206721
    m_Localized: "C\u1EECA H\xC0NG C\u1EE6A B\u1EA0N"
    m_Metadata:
      m_Items: []
  - m_Id: 101445138206722
    m_Localized: "B\u1ECF qua h\u01B0\u1EDBng d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 101445138206723
    m_Localized: "H\u1ECDc c\xE1ch ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 102117258645504
    m_Localized: "WASD  \u2022  Chu\u1ED9t \u0111\u1EC3 nh\xECn"
    m_Metadata:
      m_Items: []
  - m_Id: 102117267034112
    m_Localized: "K\xE9o b\xEAn tr\xE1i \u0111\u1EC3 \u0111i \u2022 b\xEAn ph\u1EA3i
      \u0111\u1EC3 nh\xECn"
    m_Metadata:
      m_Items: []
  - m_Id: 120139620896768
    m_Localized: "Nh\u1EA5p tr\xE1i \u0111\u1EC3 nh\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 120139650256896
    m_Localized: "Nh\u1EA5p ph\u1EA3i \u0111\u1EC3 \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 120139650256897
    m_Localized: "Nh\u1EA5p tr\xE1i \u0111\u1EC3 l\u1EA5y l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 120139650256898
    m_Localized: "Ch\u1EA1m n\xFAt b\xE0n tay \u0111\u1EC3 nh\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 120139650256899
    m_Localized: "Ch\u1EA1m n\xFAt \u0111\u1EB7t \u0111\u1EC3 x\u1EBFp xe"
    m_Metadata:
      m_Items: []
  - m_Id: 120139650256900
    m_Localized: "Ch\u1EA1m n\xFAt b\xE0n tay \u0111\u1EC3 l\u1EA5y l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 1202631123750912
    m_Localized: "Nh\u1EB7t m\u1ED9t chi\u1EBFc xe"
    m_Metadata:
      m_Items: []
  - m_Id: 1202631190859776
    m_Localized: "T\xECm k\u1EC7 ph\xF9 h\u1EE3p"
    m_Metadata:
      m_Items: []
  - m_Id: 1202631190859777
    m_Localized: "\u0110\u1EB7t xe \u1EDF \u0111\xE2y"
    m_Metadata:
      m_Items: []
  references:
    version: 2
