  - m_Id: 15447427469330
    m_Localized: '{0} xu  +  {1} KN'
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469331
    m_Localized: "Nh\u1EADn th\u01B0\u1EDFng t\u1EA1i b\u1EA3ng nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469332
    m_Localized: "\u0110\xE3 ho\xE0n th\xE0nh m\u1ECDi th\u1EED th\xE1ch c\u1EE7a
      c\u1EEDa h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469333
    m_Localized: "Nhi\u1EC7m v\u1EE5 \u0111\xE3 nh\u1EADn th\u01B0\u1EDFng s\u1EBD
      hi\u1EC7n \u1EDF \u0111\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469334
    m_Localized: "\u0110\xE3 ho\xE0n th\xE0nh h\xE0nh tr\xECnh s\u01B0u t\u1EA7m!"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469335
    m_Localized: "HO\xC0N TH\xC0NH NHI\u1EC6M V\u1EE4"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469336
    m_Localized: "T\u0102NG H\u1EA0NG S\u01AFU T\u1EA6M"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469337
    m_Localized: "T\xE2n binh"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469338
    m_Localized: "Ng\u01B0\u1EDDi s\u1EAFp x\u1EBFp"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469339
    m_Localized: "Nh\xE0 s\u01B0u t\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469340
    m_Localized: "Chuy\xEAn gia"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469341
    m_Localized: "B\u1EADc th\u1EA7y s\u01B0u t\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469342
    m_Localized: "Tr\u01B0ng b\xE0y \u0111\u1EA7u ti\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 15447427469343
    m_Localized: "B\u1EAFt \u0111\u1EA7u ng\u0103n n\u1EAFp"
    m_Metadata:
      m_Items: []
