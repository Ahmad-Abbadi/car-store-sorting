  m_TableData:
  - m_Id: 7091343360
    m_Localized: "Coupe du l\u1ECBch"
    m_Metadata:
      m_Items: []
  - m_Id: 7296864256
    m_Localized: "Coupe t\u1ED1c \u0111\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 7301058560
    m_Localized: "B\u1ECD c\xE1nh c\u1EE9ng \u0111ua \u0111\u1ECBa h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 7301058561
    m_Localized: "SUV \u0111ua \u0111\u1ECBa h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 7301058562
    m_Localized: "Hatchback \u0111ua \u0111\u1ECBa h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252864
    m_Localized: "Xe \u0111ua c\xF4ng th\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252865
    m_Localized: "Xe giao h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252866
    m_Localized: "Xe \u0111ua bu\u1ED3ng l\xE1i m\u1EDF"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252867
    m_Localized: "Nguy\xEAn m\u1EABu \u0111\u01B0\u1EDDng \u0111ua"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252868
    m_Localized: "Coupe \u0111\u01B0\u1EDDng tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252869
    m_Localized: "Xe buggy \u0111\u1ECBa h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252870
    m_Localized: "Jeep \u0111\u01B0\u1EDDng m\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252871
    m_Localized: "Xe t\u1EA3i ch\u1EDF h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252872
    m_Localized: "Xe buggy sa m\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252873
    m_Localized: "Xe mui tr\u1EA7n c\u1ED5 \u0111i\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252874
    m_Localized: "V\xED d\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252875
    m_Localized: Gom
    m_Metadata:
      m_Items: []
  - m_Id: 7305252876
    m_Localized: "Nh\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252877
    m_Localized: "D\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252878
    m_Localized: "\u0110\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252879
    m_Localized: "\u0110\u1ED5i"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252880
    m_Localized: "T\xFAi \u0111\u1ED3 \u0111\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252881
    m_Localized: Sai khu
    m_Metadata:
      m_Items: []
  - m_Id: 7305252882
    m_Localized: "Gi\u1ECFi l\u1EAFm!"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252883
    m_Localized: "Qu\u1EA3 c\u1EA7u xanh d\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252884
    m_Localized: "Kh\u1ED1i tr\u1EE5 xanh l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252885
    m_Localized: "V\xED d\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252886
    m_Localized: "Kh\u1ED1i l\u1EADp ph\u01B0\u01A1ng \u0111\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252887
    m_Localized: "Coupe du l\u1ECBch T\xF9y ch\u1EC9nh Xanh c\u1ED5 v\u1ECBt"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252888
    m_Localized: "Coupe du l\u1ECBch T\xF9y ch\u1EC9nh Xanh l\u01A1"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252889
    m_Localized: "Coupe du l\u1ECBch T\xF9y ch\u1EC9nh Xanh coban"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252890
    m_Localized: "Coupe du l\u1ECBch T\xF9y ch\u1EC9nh T\xEDm"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252891
    m_Localized: "Coupe du l\u1ECBch T\xF9y ch\u1EC9nh H\u1ED3ng v\xE2n anh"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252892
    m_Localized: "Coupe du l\u1ECBch Ti\xEAu chu\u1EA9n \u0110\u1ECF t\u01B0\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252893
    m_Localized: "Coupe du l\u1ECBch Ti\xEAu chu\u1EA9n Cam qu\xFDt"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252894
    m_Localized: "Coupe du l\u1ECBch Ti\xEAu chu\u1EA9n H\u1ED5 ph\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 7305252895
